# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Claude Code
.claude

# 忽略 social-monitor 以外的所有文件和目录
/*
!/社媒监控系统/
社媒监控系统/*
!社媒监控系统/social-monitor/
!/.gitignore
!/AGENTS.md
!/README.md
!/Dockerfile
!/docker-entrypoint.sh
!/.dockerignore
!/.deployhub/
!/.deployhub/**
!/workbench/
!/workbench/**

# Collector runtime retry queue
社媒监控系统/social-monitor/collector-outbox/

# WhatsApp runtime credentials and cache
社媒监控系统/social-monitor/.wwebjs_auth/
社媒监控系统/social-monitor/.wwebjs_cache/
社媒监控系统/social-monitor/whatsapp-session-*/
社媒监控系统/social-monitor/wa-diagnostics/

# Local DingTalk webhook secrets
社媒监控系统/social-monitor/config/webhooks.json

# SQLite transient files
社媒监控系统/social-monitor/*.sqlite-wal
社媒监控系统/social-monitor/*.sqlite-shm
社媒监控系统/social-monitor/db/*.sqlite-wal
社媒监控系统/social-monitor/db/*.sqlite-shm

# Agent tools config files
社媒监控系统/social-monitor/.gemini/
社媒监控系统/social-monitor/.specify/
!社媒监控系统/social-monitor/.specify/
社媒监控系统/social-monitor/.specify/*
!社媒监控系统/social-monitor/.specify/specs/
社媒监控系统/social-monitor/.specify/specs/*
!社媒监控系统/social-monitor/.specify/specs/008-workbench-manual-grouping/
!社媒监控系统/social-monitor/.specify/specs/008-workbench-manual-grouping/**

# Workbench local runtime outputs
workbench/node_modules/
workbench/frontend/dist/
workbench/db/*.sqlite
workbench/db/*.sqlite-wal
workbench/db/*.sqlite-shm
workbench/outbox/
workbench/.env
workbench/coverage/

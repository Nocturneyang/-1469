{
  "name": "social-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Pure IM operations workbench for social monitor channel messages.",
  "type": "commonjs",
  "scripts": {
    "dev": "node server/index.js",
    "dev:api": "node server/index.js",
    "dev:frontend": "node node_modules/vite/bin/vite.js --config frontend/vite.config.mjs --host 0.0.0.0",
    "build": "WORKBENCH_BASE_PATH=/ node node_modules/vite/bin/vite.js build --config frontend/vite.config.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --config frontend/vite.config.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "login-worker": "node workers/service-login-worker.js",
    "account-worker": "node workers/account-runtime-worker.js",
    "account-supervisor": "node workers/account-worker-supervisor.js",
    "backup:daily": "node scripts/sqlite-backup.js daily",
    "backup:weekly": "node scripts/sqlite-backup.js weekly",
    "restore:stage": "node scripts/sqlite-restore-stage.js",
    "maintenance:daily": "node scripts/sqlite-maintenance.js",
    "predeploy:check": "node scripts/predeploy-check.js",
    "init-db": "node scripts/init-db.js",
    "seed:demo": "node scripts/seed-demo-raw-db.js",
    "seed:demo-workbench": "node scripts/seed-demo-workbench-db.js",
    "outbound:demo": "node scripts/demo-outbound-consumer.js",
    "test": "node tests/frontend-component-registration.test.js && node tests/frontend-composer-contract.test.js && node tests/share-preview.test.js && node tests/workbench-api.test.js && node tests/outbound-consumer.test.js && node tests/outbound-doorbell.test.js && node tests/account-isolation.test.js && node tests/account-runtime-worker.test.js && node tests/chrome-launch.test.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "element-plus": "^2.14.0",
    "express": "^5.2.1",
    "node-telegram-bot-api": "^1.1.2",
    "puppeteer": "^24.40.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode-terminal": "^0.12.0",
    "telegram": "^2.26.22",
    "vite": "^8.0.12",
    "vue": "^3.5.34",
    "whatsapp-web.js": "^1.34.7"
  },
  "overrides": {
    "brace-expansion": "2.1.2",
    "minimatch@3": {
      "brace-expansion": "1.1.16"
    }
  }
}

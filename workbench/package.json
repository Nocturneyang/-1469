{
  "name": "social-monitor-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Pure IM operations workbench for social monitor channel messages.",
  "type": "commonjs",
  "scripts": {
    "dev": "node server/index.js",
    "dev:api": "node server/index.js",
    "dev:frontend": "vite --config frontend/vite.config.mjs --host 0.0.0.0",
    "build": "vite build --config frontend/vite.config.mjs",
    "preview": "vite preview --config frontend/vite.config.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "init-db": "node scripts/init-db.js",
    "seed:demo": "node scripts/seed-demo-raw-db.js",
    "seed:demo-workbench": "node scripts/seed-demo-workbench-db.js",
    "outbound:demo": "node scripts/demo-outbound-consumer.js",
    "test": "node tests/workbench-api.test.js && node tests/outbound-consumer.test.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "element-plus": "^2.14.0",
    "express": "^5.2.1",
    "vite": "^8.0.12",
    "vue": "^3.5.34"
  },
  "devDependencies": {}
}

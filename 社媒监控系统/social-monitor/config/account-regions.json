  "_comment": "WhatsApp/Telegram 采集账号与区域映射配置。新增账号时只需在此添加一条记录，无需修改代码。",
  "_schema": {
    "account": "数据库中 receiver_account 字段的值",
    "region": "中文区域名称（用于日报群名前缀，格式：XX区-群名）",
    "platform": "wa | tg | tgu | teams",
    "business_sector": "业务板块：直连供应商/语音直连供应商/设备供应商/客服/卡线",
    "value_label": "群聊价值标签 L0/L1/L2/L3（缺省 L1，仅手动配置）",
    "owner": "区域主责运营人员",
    "owner_dingtalk_id": "钉钉/企微 用户ID，P0告警时 @ 该人",
    "description": "备注说明"
  },
  "_value_label_guide": {
    "L0": "关键通道/高价值群 — 全量告警 + 日报重点呈现 + 周报评分",
    "L1": "常规供应商/活跃群 — P0/P1 告警 + 日报纳入 + 周报评分（缺省值）",
    "L2": "低优先级/偶发群 — 仅 P0 告警 + 日报沉默提醒 + 不纳入周报评分",
    "L3": "观察/归档群 — 完全静默，不推送告警，仅存档"
  },

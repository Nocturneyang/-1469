TG_BOT_TOKEN=your_telegram_bot_token_here

# Web/API 登录 JWT 签名密钥。生产环境必须配置，长度至少 32 位。
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_random_jwt_secret_at_least_32_chars

# Web UI 账号管理调用 PM2 的命令超时和重启前等待时间
# ACCOUNT_PM2_COMMAND_TIMEOUT_MS=60000
# ACCOUNT_RESTART_DELAY_MS=500

# 云端账号采集运行时。生产由 .deployhub/k8s/app.yaml 注入镜像和开关。
# CLOUD_COLLECTOR_ENABLED=true
# CLOUD_COLLECTOR_IMAGE=registry.example.com/social-monitor:latest
# CLOUD_COLLECTOR_API_URL=http://social-monitor/api/collector
# CLOUD_COLLECTOR_PVC=social-monitor-sqlite-pvc

# 账号会话加密密钥。必须固定配置；用于 TG 用户号 session 和 Teams OAuth token。
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCOUNT_SESSION_ENCRYPTION_KEY=replace_with_random_account_session_key

# Data Sync Configuration
SYNC_URL=https://nwp-service.tyhsys.com/api/v1/social-monitor/messages/sync
SYNC_TOKEN=your_bearer_token_here
MEDIA_BASE_URL=http://your-server-ip:3000

# ─────────────────────────────────────────────────
# Skyline Ark SSO（Deploy Hub/Rainbond 上线时启用）
# ─────────────────────────────────────────────────

# 本地开发默认关闭；平台部署通过 .deployhub/k8s/app.yaml 开启
# SSO_ENABLED=true

# 平台统一登录页。前端通过 /runtime-config.js 运行时读取，不需要重新构建镜像
# SSO_LOGIN_URL=https://skyline-ark-sso.tyhark.com/login

# 可选：后端远程校验 Bearer/satoken 并映射用户信息；网关注入用户头时可不配置
# SSO_USERINFO_URL=https://skyline-ark-sso.tyhark.com/token/userinfo
# SSO_USERINFO_TIMEOUT_MS=4000

# 可选：逗号分隔的 SSO 管理员身份，匹配 id/username/email；也可由网关注入 x-user-role=admin
# SSO_ADMIN_USERS=admin@example.com,10001
# SSO_DEFAULT_ROLE=viewer

# ─────────────────────────────────────────────────
# Collector 上报协议（WA 采集器隔离部署时使用）
# ─────────────────────────────────────────────────

# 主系统用于校验采集器上报的共享 Token，主系统和 collector 必须一致
COLLECTOR_TOKEN=replace_with_random_collector_token

# Collector 媒体上报体积限制，按需要调大；建议先控制在 30MB 内
COLLECTOR_BODY_LIMIT=30mb

# 主系统镜像默认不安装 Chrome；本地开发如需更新 Puppeteer Chrome，可执行 npm run chrome:install
# SKIP_CHROME_INSTALL=true

# 独立 WA collector 容器配置此地址后，不再直接写 SQLite，而是通过 HTTP 上报
# COLLECTOR_API_URL=https://your-social-monitor.example.com

# Collector API 短暂不可用时，消息/媒体/事件会先落到本地 outbox，恢复后自动补发
# COLLECTOR_OUTBOX_ENABLED=true
# COLLECTOR_OUTBOX_DIR=/data/collector-outbox
# COLLECTOR_OUTBOX_FLUSH_MS=30000

# 独立 collector 必填：账号名，例如 nanya_wa / yatai-wa
# ACCOUNT_NAME=nanya_wa

# 主系统 PVC/数据目录水位保护；低于任一阈值时 /readyz 返回 503，避免继续写坏 SQLite
# STORAGE_MIN_FREE_MB=512
# STORAGE_MIN_FREE_PERCENT=5

# 媒体治理脚本参数；默认只清理超过宽限期的孤儿文件，引用中的媒体不会被删除
# MEDIA_ORPHAN_GRACE_DAYS=7
# MEDIA_RETENTION_DAYS=0

# SQLite 备份目录与保留期；默认写入 DATA_DIR/backups
# BACKUP_DIR=/data/backups
# BACKUP_RETENTION_DAYS=14

# messages 热/冷归档；npm run db:archive 默认 dry-run，显式 -- --execute 才会移动旧消息
# MESSAGE_ARCHIVE_RETENTION_DAYS=180
# MESSAGE_ARCHIVE_MAX_ROWS=50000
# MESSAGE_ARCHIVE_DIR=/data/db/archives

# Orchestrator 运行时适配器：本地默认 pm2；线上 collector 拆分后可切 k8s/rainbond
# WA_RUNTIME_ADAPTER=pm2
# WA_RUNTIME_ADAPTER=k8s
# WA_K8S_CLIENT=auto  # auto=集群内 API 优先，kubectl 回退；也可设 api/kubectl
# WA_K8S_NAMESPACE=g1469
# WA_K8S_LABEL_SELECTOR=app.kubernetes.io/part-of=social-monitor-wa
# WA_K8S_ACCOUNT_LABEL=wa-account
# WA_K8S_DEPLOYMENT_PREFIX=wa-collector-
# WA_K8S_DEPLOYMENT_MAP={"nanya_wa":"wa-collector-nanya-wa"}
# KUBECTL_BIN=kubectl  # 仅 WA_K8S_CLIENT=kubectl 或 API 回退时需要

# ─────────────────────────────────────────────────
# 钉钉机器人 Webhook（各维度独立，详见 config/webhooks.json）
# ─────────────────────────────────────────────────

# 维度1+2：🚨 告警群机器人（P0/P1实时告警 + 问题超时升级）
DINGTALK_ALERT=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ALERT_TOKEN
# 平台专属告警（可选，未配置时回退全局）
# DINGTALK_ALERT_WA=https://oapi.dingtalk.com/robot/send?access_token=YOUR_WA_ALERT_TOKEN
# DINGTALK_ALERT_TG=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TG_ALERT_TOKEN
# DINGTALK_ALERT_TGU=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TGU_ALERT_TOKEN
# DINGTALK_ALERT_TEAMS=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TEAMS_ALERT_TOKEN

# 维度3：📋 日报群机器人（每天09:00推送每日群汇总）
DINGTALK_DIGEST=https://oapi.dingtalk.com/robot/send?access_token=YOUR_DIGEST_TOKEN
# DINGTALK_DIGEST_WA=...
# DINGTALK_DIGEST_TG=...
# DINGTALK_DIGEST_TGU=...
# DINGTALK_DIGEST_TEAMS=...

# 维度4：📊 管理周报机器人（每周一09:00推送供应商可靠性评分）
DINGTALK_WEEKLY=https://oapi.dingtalk.com/robot/send?access_token=YOUR_WEEKLY_TOKEN
# DINGTALK_WEEKLY_WA=...
# DINGTALK_WEEKLY_TG=...
# DINGTALK_WEEKLY_TGU=...
# DINGTALK_WEEKLY_TEAMS=...

# ─────────────────────────────────────────────────
# AI 分析 API 配置（供应商告警引擎 + 每日日报摘要）
# 支持 OpenAI 兼容接口（one-api 中转）或直接调用 Gemini
# 调用优先级：OpenAI 兼容接口 → Gemini → 纯关键词降级模式
# ─────────────────────────────────────────────────

# OpenAI 兼容接口密钥（one-api 或官方 OpenAI 均可）
OPENAI_API_KEY=your_openai_api_key_here

# 接口地址（one-api 中转填目标地址；使用官方接口留空或填 https://api.openai.com/v1）
OPENAI_BASE_URL=https://oneapi.itniotech.cn/v1

# ─── 分层模型配置（按场景选用最佳性价比）───────────────────────
#
# FAST    — 高频轻量（供应商告警 / 内容审核 / 模板提取），追求低成本和低延迟
# DEFAULT — 中等任务（QA / 设备知识 / 供应商画像 / 日报），中文业务判断稳定
# PRO     — 低频高质量长文默认档；周报等可用场景变量单独指定
#
# 推荐组合（OneAPI 模型广场 https://oneapi.itniotech.cn/pricing）：
#   FAST    = deepseek-v4-flash                 # 高频短 JSON、告警/抽取
#   DEFAULT = deepseek-v4-pro                   # 中文分析、日报、画像主力
#   PRO     = claude-sonnet-4.5                 # 低频周报/管理摘要
#
# 场景变量优先级最高；未设置时使用代码内推荐默认值。
OPENAI_MODEL=deepseek-v4-pro
OPENAI_MODEL_FAST=deepseek-v4-flash
OPENAI_MODEL_PRO=claude-sonnet-4.5
ALERT_AI_MODEL=deepseek-v4-flash
EXTRACTION_AI_MODEL=deepseek-v4-flash
KNOWLEDGE_AI_MODEL=deepseek-v4-pro
DAILY_DIGEST_AI_MODEL=deepseek-v4-pro
WEEKLY_RELIABILITY_AI_MODEL=claude-sonnet-4.5
SUPPLIER_PROFILE_AI_MODEL=deepseek-v4-pro
SUPPLIER_PROFILE_AI_CONCURRENCY=1
SUPPLIER_PROFILE_AI_MAX_TOKENS=1200
SUPPLIER_PROFILE_AI_TIMEOUT_MS=60000

# Google Gemini（可选备用，均未配置时自动降级为纯关键词模式）
# 申请地址：https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────
# TG MTProto 用户账号配置（MTProto/GramJS，可接入历史消息）
# 申请 api_id / api_hash：https://my.telegram.org → App configuration
# ─────────────────────────────────────────────────

# Session String（由系统自动写入，请勿手动修改）
# TG_USER_SESSION_ACCOUNT1=<gramjs session string>

# 频控参数（以 {账号名大写} 为后缀，每个账号独立配置）
# TG_WARMUP_SECONDS_ACCOUNT1=600        # 登录后预热静默期（秒，不拉历史）
# TG_DAILY_LIMIT_ACCOUNT1=2000          # 每日历史消息最大拉取条数
# TG_BATCH_SIZE_ACCOUNT1=100            # 每批次拉取条数（50~200）
# TG_SLEEP_MIN_MS_ACCOUNT1=3000         # 批次间最小间隔（毫秒）
# TG_SLEEP_MAX_MS_ACCOUNT1=8000         # 批次间最大间隔（毫秒）
# TG_BACKFILL_DAYS_ACCOUNT1=7           # 历史回溯天数（0=不回溯，-1=全部）
# TG_ENABLE_BACKFILL_ACCOUNT1=true      # 是否开启历史回溯

# ─────────────────────────────────────────────────
# Microsoft Teams Graph API 配置（OAuth 2.0 授权）
# ─────────────────────────────────────────────────

# 授权模式：'device'（设备代码流，个人账户，推荐）或 'code'（授权码流，企业账户）
# 设备代码流无需 Azure Portal 注册，个人账户可直接使用
TEAMS_AUTH_MODE=device

# Microsoft Graph 应用注册信息（仅授权码流需要）
# 设备代码流使用 Microsoft 公共客户端 ID，无需配置
# 在 Azure Portal 注册应用：https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_GRAPH_CLIENT_ID=your_client_id_here
MICROSOFT_GRAPH_CLIENT_SECRET=your_client_secret_here

# OAuth 回调地址（仅授权码流需要，必须与 Azure Portal 中配置的重定向 URI 一致）
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:3000/api/teams/callback

# 兼容旧配置；新部署统一使用 ACCOUNT_SESSION_ENCRYPTION_KEY。
# TEAMS_TOKEN_ENCRYPTION_KEY=your_legacy_encryption_key_here

# Teams 群聊白名单（以 {账号名大写} 为后缀，每个账号独立配置）
# 留空表示监控所有群聊，逗号分隔 chatId 或群名
# TEAMS_WHITELIST_ACCOUNT1=chatId1,chatId2,群聊名称1

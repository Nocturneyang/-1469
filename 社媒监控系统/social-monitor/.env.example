TG_BOT_TOKEN=your_telegram_bot_token_here

# Data Sync Configuration
SYNC_URL=https://nwp-service.tyhsys.com/api/v1/social-monitor/messages/sync
SYNC_TOKEN=your_bearer_token_here
MEDIA_BASE_URL=http://your-server-ip:3000

# ─────────────────────────────────────────────────
# 钉钉机器人 Webhook（各维度独立，详见 config/webhooks.json）
# ─────────────────────────────────────────────────

# 维度1+2：🚨 告警群机器人（P0/P1实时告警 + 问题超时升级）
DINGTALK_ALERT=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ALERT_TOKEN
# 平台专属告警（可选，未配置时回退全局）
# DINGTALK_ALERT_WA=https://oapi.dingtalk.com/robot/send?access_token=YOUR_WA_ALERT_TOKEN
# DINGTALK_ALERT_TG=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TG_ALERT_TOKEN
# DINGTALK_ALERT_TGU=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TGU_ALERT_TOKEN
# DINGTALK_ALERT_TEAMS=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TEAMS_ALERT_TOKEN

# 维度3：📋 日报群机器人（每天09:00推送每日群汇总）
DINGTALK_DIGEST=https://oapi.dingtalk.com/robot/send?access_token=YOUR_DIGEST_TOKEN
# DINGTALK_DIGEST_WA=...
# DINGTALK_DIGEST_TG=...
# DINGTALK_DIGEST_TGU=...
# DINGTALK_DIGEST_TEAMS=...

# 维度4：📊 管理周报机器人（每周一09:00推送供应商可靠性评分）
DINGTALK_WEEKLY=https://oapi.dingtalk.com/robot/send?access_token=YOUR_WEEKLY_TOKEN
# DINGTALK_WEEKLY_WA=...
# DINGTALK_WEEKLY_TG=...
# DINGTALK_WEEKLY_TGU=...
# DINGTALK_WEEKLY_TEAMS=...

# ─────────────────────────────────────────────────
# AI 分析 API 配置（供应商告警引擎 + 每日日报摘要）
# 支持 OpenAI 兼容接口（one-api 中转）或直接调用 Gemini
# 调用优先级：OpenAI 兼容接口 → Gemini → 纯关键词降级模式
# ─────────────────────────────────────────────────

# OpenAI 兼容接口密钥（one-api 或官方 OpenAI 均可）
OPENAI_API_KEY=your_openai_api_key_here

# 接口地址（one-api 中转填目标地址；使用官方接口留空或填 https://api.openai.com/v1）
OPENAI_BASE_URL=https://oneapi.itniotech.cn/v1

# ─── 分层模型配置（按场景选用最佳性价比）───────────────────────
#
# DEFAULT — 中等任务（供应商告警 / QA / 设备知识 / 上下文校验），中文聚合表现强
# FAST    — 高频轻量（内容审核 / 模板提取 / P0 上下文校验），追求低成本
# PRO     — 高质量长文（每日日报 / 周报 / 供应商画像），对推理质量敏感
#
# 推荐组合（OneAPI 模型广场 https://oneapi.itniotech.cn/pricing）：
#   DEFAULT = deepseek-v3                       # 极低价格，中文最强梯队
#   FAST    = anthropic/claude-haiku-4.5        # $0.3/$2.4 /M，速度快
#   PRO     = anthropic/claude-3.7-sonnet       # 长文报告质量高
#   备选 PRO: gemini-2.5-pro / gpt-4.1
#
# 仅设置 OPENAI_MODEL 时，FAST 和 PRO 自动使用上面的默认值。
OPENAI_MODEL=deepseek-v3
OPENAI_MODEL_FAST=anthropic/claude-haiku-4.5
OPENAI_MODEL_PRO=anthropic/claude-3.7-sonnet

# Google Gemini（可选备用，均未配置时自动降级为纯关键词模式）
# 申请地址：https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────
# TG MTProto 用户账号配置（MTProto/GramJS，可接入历史消息）
# 申请 api_id / api_hash：https://my.telegram.org → App configuration
# ─────────────────────────────────────────────────

# Session String（由系统自动写入，请勿手动修改）
# TG_USER_SESSION_ACCOUNT1=<gramjs session string>

# 频控参数（以 {账号名大写} 为后缀，每个账号独立配置）
# TG_WARMUP_SECONDS_ACCOUNT1=600        # 登录后预热静默期（秒，不拉历史）
# TG_DAILY_LIMIT_ACCOUNT1=2000          # 每日历史消息最大拉取条数
# TG_BATCH_SIZE_ACCOUNT1=100            # 每批次拉取条数（50~200）
# TG_SLEEP_MIN_MS_ACCOUNT1=3000         # 批次间最小间隔（毫秒）
# TG_SLEEP_MAX_MS_ACCOUNT1=8000         # 批次间最大间隔（毫秒）
# TG_BACKFILL_DAYS_ACCOUNT1=7           # 历史回溯天数（0=不回溯，-1=全部）
# TG_ENABLE_BACKFILL_ACCOUNT1=true      # 是否开启历史回溯

# ─────────────────────────────────────────────────
# Microsoft Teams Graph API 配置（OAuth 2.0 授权）
# ─────────────────────────────────────────────────

# 授权模式：'device'（设备代码流，个人账户，推荐）或 'code'（授权码流，企业账户）
# 设备代码流无需 Azure Portal 注册，个人账户可直接使用
TEAMS_AUTH_MODE=device

# Microsoft Graph 应用注册信息（仅授权码流需要）
# 设备代码流使用 Microsoft 公共客户端 ID，无需配置
# 在 Azure Portal 注册应用：https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_GRAPH_CLIENT_ID=your_client_id_here
MICROSOFT_GRAPH_CLIENT_SECRET=your_client_secret_here

# OAuth 回调地址（仅授权码流需要，必须与 Azure Portal 中配置的重定向 URI 一致）
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:3000/api/teams/callback

# Token 加密密钥（用于加密存储 access_token 和 refresh_token）
# 建议使用随机生成的 32 字节十六进制字符串
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEAMS_TOKEN_ENCRYPTION_KEY=your_encryption_key_here

# Teams 群聊白名单（以 {账号名大写} 为后缀，每个账号独立配置）
# 留空表示监控所有群聊，逗号分隔 chatId 或群名
# TEAMS_WHITELIST_ACCOUNT1=chatId1,chatId2,群聊名称1
